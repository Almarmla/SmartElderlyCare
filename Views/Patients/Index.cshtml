@model IReadOnlyList<SmartElderlyCare.Models.Patient>
@using SmartElderlyCare.Services
@{
    ViewData["Title"] = "Patients";
    var riskResults = ViewData["PatientRiskLevels"] as IReadOnlyDictionary<int, PatientRiskResult>;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="eyebrow">Patient registry</span>
            <h1 class="mt-3 mb-1">Registered patients</h1>
            <p class="text-muted mb-0">View the elderly people enrolled in the chronic care programme.</p>
        </div>
        <a class="btn primary-button px-4" asp-action="Register">Register patient</a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <form method="get" class="card border-0 shadow-sm p-3 mb-3">
        <div class="input-group">
            <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by patient number, name, or condition" />
            <button class="btn btn-outline-success" type="submit">Search</button>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Patient number</th>
                        <th>Condition</th>
                        <th>Care programme</th>
                        <th>Contact</th>
                        <th>Risk</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">No patients have been registered yet.</td></tr>
                }
                else
                {
                    @foreach (var patient in Model)
                    {
                        <tr>
                            <td><strong>@patient.FirstName @patient.LastName</strong><br /><small class="text-muted">@patient.Sex · @patient.DateOfBirth</small></td>
                            <td>@patient.PatientNumber</td>
                            <td>@patient.MedicalCondition</td>
                            <td>@patient.ChronicCareProgramme</td>
                            <td>@(patient.PhoneNumber ?? "Not provided")</td>
                            <td>
                                @if (riskResults is not null && riskResults.TryGetValue(patient.Id, out var result))
                                {
                                    <partial name="_RiskBadge" model="@result" />
                                }
                            </td>
                            <td><a class="btn btn-sm btn-outline-success" asp-action="History" asp-route-id="@patient.Id">History</a></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
