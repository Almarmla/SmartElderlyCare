@model SmartElderlyCare.Models.PatientHistoryViewModel
@using SmartElderlyCare.Services
@{
    ViewData["Title"] = "Patient History";
    var riskResult = ViewData["PatientRiskResult"] as PatientRiskResult;
    var isArchived = ViewData["IsArchived"] is true;
    var canManagePatient = User.IsInRole(ApplicationRoles.Nurse)
        || User.IsInRole(ApplicationRoles.FacilityNurse)
        || User.IsInRole(ApplicationRoles.DhioAdmin)
        || User.IsInRole(ApplicationRoles.Administrator);

    var periodStart = Model.ShowAllTime ? null : Model.StartDate.ToString("yyyy-MM-dd");
    var periodEnd = Model.ShowAllTime ? null : Model.EndDate.ToString("yyyy-MM-dd");
    var allTimeRouteValue = Model.ShowAllTime ? null : "false";

    var orderedReadings = Model.Readings.OrderBy(item => item.RecordedAt).ToList();
    var bpReadings = orderedReadings
        .Where(item => item.SystolicBloodPressure.HasValue && item.DiastolicBloodPressure.HasValue)
        .ToList();
    var pulseReadings = orderedReadings.Where(item => item.PulseRate.HasValue).ToList();
    var bpLabels = bpReadings.Select(item => item.RecordedAt.ToLocalTime().ToString("dd MMM HH:mm")).ToArray();
    var systolicValues = bpReadings.Select(item => item.SystolicBloodPressure!.Value).ToArray();
    var diastolicValues = bpReadings.Select(item => item.DiastolicBloodPressure!.Value).ToArray();
    var pulseLabels = pulseReadings.Select(item => item.RecordedAt.ToLocalTime().ToString("dd MMM HH:mm")).ToArray();
    var pulseValues = pulseReadings.Select(item => item.PulseRate!.Value).ToArray();
}

<div class="container py-4 patient-history-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div class="patient-bio-data">
            <a asp-action="Index" asp-route-showArchived="@(isArchived ? "true" : "false")" class="text-success print-hide">← Patient registry</a>
            <span class="eyebrow d-block mt-3 print-hide">Patient capture history</span>
            <h1 class="mt-2 mb-1">@Model.Patient.FirstName @Model.Patient.LastName</h1>
            <p class="text-muted mb-0">@Model.Patient.PatientNumber · @Model.Patient.MedicalCondition · @Model.Patient.ChronicCareProgramme</p>
            @if (riskResult is not null)
            {
                <div class="mt-2"><partial name="_RiskBadge" model="@riskResult" /></div>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 print-hide">
            <button type="button" class="btn btn-outline-success" onclick="window.print()">Print Clinical Summary</button>
            @if (canManagePatient)
            {
                <a class="btn btn-outline-success" asp-action="Edit" asp-route-id="@Model.Patient.Id">Edit Patient</a>
            }
            <a class="btn btn-outline-success" asp-action="History" asp-route-id="@Model.Patient.Id" asp-route-startDate="@periodStart" asp-route-endDate="@periodEnd" asp-route-allTime="@allTimeRouteValue">Refresh history</a>
        </div>
    </div>

    @if (isArchived)
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <strong>This patient record is currently ARCHIVED.</strong>
                <div class="small mt-1">The record is read-only in the registry. Restore it to resume archiving, editing, and routine care workflows.</div>
            </div>
            @if (canManagePatient)
            {
                <form method="post" asp-action="ToggleStatus" class="m-0 print-hide">
                    <input type="hidden" name="id" value="@Model.Patient.Id" />
                    <button class="btn btn-sm btn-outline-primary" type="submit">Unarchive Patient</button>
                </form>
            }
        </div>
    }

    <form method="get" class="card border-0 shadow-sm p-3 mb-4 print-hide">
        <input type="hidden" name="id" value="@Model.Patient.Id" />
        <div class="row g-3 align-items-end">
            <div class="col-md-3"><label for="startDate" class="form-label">From</label><input id="startDate" name="startDate" type="date" value="@periodStart" class="form-control" /></div>
            <div class="col-md-3"><label for="endDate" class="form-label">To</label><input id="endDate" name="endDate" type="date" value="@periodEnd" class="form-control" /></div>
            <div class="col-md-4">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="allTime" name="allTime" value="true" checked="@Model.ShowAllTime" />
                    <label class="form-check-label" for="allTime">Show all recorded activity</label>
                </div>
                <button class="btn primary-button w-100" type="submit">Apply period</button>
            </div>
        </div>
    </form>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger print-hide"></div>
    <div class="row g-3 mb-4 print-hide">
        <div class="col-sm-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Vital readings</small><strong class="display-6">@Model.Readings.Count</strong></div></div>
        <div class="col-sm-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">VHW checks</small><strong class="display-6">@Model.WelfareChecks.Count</strong></div></div>
        <div class="col-sm-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Facility visits</small><strong class="display-6">@Model.FacilityVisits.Count</strong></div></div>
        <div class="col-sm-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Alerts</small><strong class="display-6">@Model.Alerts.Count</strong></div></div>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-4">
        <h2 class="h5">Vital-sign trend</h2>
        <p class="text-muted">Readings in the selected period, oldest first for trend review.</p>
        <div class="row g-4 mb-4 print-hide">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-3 h-100">
                    <h3 class="h6">Blood pressure over time</h3>
                    @if (bpReadings.Count > 0)
                    {
                        <div class="chart-box"><canvas id="bpTrendChart"></canvas></div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No blood pressure readings in the selected period.</p>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-3 h-100">
                    <h3 class="h6">Pulse rate over time</h3>
                    @if (pulseReadings.Count > 0)
                    {
                        <div class="chart-box"><canvas id="pulseTrendChart"></canvas></div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No pulse readings in the selected period.</p>
                    }
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Date</th><th>Blood pressure</th><th>Pulse</th><th>Temperature</th><th>Glucose</th></tr></thead>
                <tbody>
                @foreach (var reading in Model.Readings.OrderBy(item => item.RecordedAt))
                {
                    <tr><td>@reading.RecordedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@reading.SystolicBloodPressure/@reading.DiastolicBloodPressure mmHg</td><td>@reading.PulseRate bpm</td><td>@reading.TemperatureCelsius °C</td><td>@(reading.BloodGlucoseMgDl?.ToString() ?? "—")</td></tr>
                }
                @if (Model.Readings.Count == 0) { <tr><td colspan="5" class="text-muted">No vital readings in this period.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
            <h2 class="h5 mb-0">Activity timeline</h2>
            <span class="badge bg-secondary">@Model.Activities.Count record@(Model.Activities.Count == 1 ? "" : "s")</span>
        </div>
        <p class="text-muted">Every visit, welfare check and alert captured for this patient, newest first@(Model.ShowAllTime ? ", across the whole record" : " in the selected period").</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th style="width: 12rem;">Date</th><th style="width: 16rem;">Activity</th><th>Description</th></tr></thead>
                <tbody>
                @foreach (var activity in Model.Activities)
                {
                    <tr>
                        <td class="text-nowrap">@activity.OccurredAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@activity.Title</td>
                        <td>@(string.IsNullOrWhiteSpace(activity.Description) ? "—" : activity.Description)</td>
                    </tr>
                }
                @if (Model.Activities.Count == 0)
                {
                    <tr><td colspan="3" class="text-muted">No activity recorded@(Model.ShowAllTime ? "" : " in this period").</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-4">
        <h2 class="h5">Linked family members</h2>
        <p class="text-muted">Registered family accounts with access to this patient's care history.</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Name</th><th>Email</th><th>Relationship</th><th>Access</th></tr></thead>
                <tbody>
                @foreach (var familyLink in Model.FamilyMembers) { <tr><td>@familyLink.FamilyMemberUser.DisplayName</td><td>@familyLink.FamilyMemberUser.Email</td><td>@(familyLink.RelationshipToPatient ?? "—")</td><td>@familyLink.AccessLevel</td></tr> }
                @if (Model.FamilyMembers.Count == 0) { <tr><td colspan="4" class="text-muted">No family members are linked to this patient.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-4">
        <h2 class="h5">Active medications</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Name</th><th>Dosage</th><th>Frequency</th><th>Route</th><th>Prescribed</th></tr></thead>
                <tbody>
                @foreach (var medication in Model.Medications) { <tr><td>@medication.MedicationName</td><td>@(medication.Dosage ?? "—")</td><td>@(medication.Frequency ?? "—")</td><td>@(medication.Route ?? "—")</td><td>@medication.PrescribedAt.ToLocalTime().ToString("dd MMM yyyy")</td></tr> }
                @if (Model.Medications.Count == 0) { <tr><td colspan="5" class="text-muted">No active medications recorded.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            if (typeof Chart === 'undefined') {
                return;
            }

            var bpLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bpLabels));
            var systolicValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(systolicValues));
            var diastolicValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(diastolicValues));
            var pulseLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pulseLabels));
            var pulseValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pulseValues));

            function buildChart(canvasId, labels, datasets) {
                var canvas = document.getElementById(canvasId);
                if (!canvas) {
                    return;
                }

                new Chart(canvas.getContext('2d'), {
                    type: 'line',
                    data: { labels: labels, datasets: datasets },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: { legend: { position: 'bottom' } },
                        scales: {
                            y: { beginAtZero: false },
                            x: { ticks: { maxRotation: 45, autoSkip: true } }
                        }
                    }
                });
            }

            if (bpLabels.length > 0) {
                buildChart('bpTrendChart', bpLabels, [
                    { label: 'Systolic (mmHg)', data: systolicValues, borderColor: '#d64545', backgroundColor: 'rgba(214, 69, 69, 0.08)', tension: 0.35, fill: true },
                    { label: 'Diastolic (mmHg)', data: diastolicValues, borderColor: '#2b7a78', backgroundColor: 'rgba(43, 122, 120, 0.08)', tension: 0.35, fill: false }
                ]);
            }

            if (pulseLabels.length > 0) {
                buildChart('pulseTrendChart', pulseLabels, [
                    { label: 'Pulse (bpm)', data: pulseValues, borderColor: '#34839b', backgroundColor: 'rgba(52, 131, 155, 0.08)', tension: 0.35, fill: true }
                ]);
            }
        })();
    </script>
}
