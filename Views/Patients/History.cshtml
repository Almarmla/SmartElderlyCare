@model SmartElderlyCare.Models.PatientHistoryViewModel
@{
    ViewData["Title"] = "Patient History";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <a asp-action="Index" class="text-success">← Patient registry</a>
            <span class="eyebrow d-block mt-3">Patient capture history</span>
            <h1 class="mt-2 mb-1">@Model.Patient.FirstName @Model.Patient.LastName</h1>
            <p class="text-muted mb-0">@Model.Patient.PatientNumber · @Model.Patient.MedicalCondition · @Model.Patient.ChronicCareProgramme</p>
        </div>
        <a class="btn btn-outline-success" asp-action="History" asp-route-id="@Model.Patient.Id">Refresh history</a>
    </div>

    <form method="get" class="card border-0 shadow-sm p-3 mb-4">
        <input type="hidden" name="id" value="@Model.Patient.Id" />
        <div class="row g-3 align-items-end">
            <div class="col-md-4"><label for="startDate" class="form-label">From</label><input id="startDate" name="startDate" type="date" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col-md-4"><label for="endDate" class="form-label">To</label><input id="endDate" name="endDate" type="date" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" /></div>
            <div class="col-md-4"><button class="btn primary-button w-100" type="submit">Apply period</button></div>
        </div>
    </form>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-3 mb-4">
        <div class="col-sm-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Vital readings</small><strong class="display-6">@Model.Readings.Count</strong></div></div>
        <div class="col-sm-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">VHW checks</small><strong class="display-6">@Model.WelfareChecks.Count</strong></div></div>
        <div class="col-sm-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Facility visits</small><strong class="display-6">@Model.FacilityVisits.Count</strong></div></div>
        <div class="col-sm-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Alerts</small><strong class="display-6">@Model.Alerts.Count</strong></div></div>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-4">
        <h2 class="h5">Vital-sign trend</h2>
        <p class="text-muted">Readings in the selected period, oldest first for trend review.</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Date</th><th>Blood pressure</th><th>Pulse</th><th>Temperature</th><th>Glucose</th></tr></thead>
                <tbody>
                @foreach (var reading in Model.Readings.OrderBy(item => item.RecordedAt))
                {
                    <tr><td>@reading.RecordedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@reading.SystolicBloodPressure/@reading.DiastolicBloodPressure mmHg</td><td>@reading.PulseRate bpm</td><td>@reading.TemperatureCelsius °C</td><td>@(reading.BloodGlucoseMgDl?.ToString() ?? "—")</td></tr>
                }
                @if (Model.Readings.Count == 0) { <tr><td colspan="5" class="text-muted">No vital readings in this period.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4">
        <h2 class="h5">Full capture history</h2>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Date</th><th>Capture</th><th>Summary</th></tr></thead>
                <tbody>
                @foreach (var visit in Model.FacilityVisits) { <tr><td>@visit.VisitAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>Facility visit</td><td>@visit.Diagnosis — @visit.Treatment</td></tr> }
                @foreach (var check in Model.WelfareChecks) { <tr><td>@check.ObservedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>VHW welfare check</td><td>@check.Status: @(check.Notes ?? "No notes")</td></tr> }
                @foreach (var observation in Model.WelfareObservations) { <tr><td>@observation.ObservedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>Welfare observation</td><td>@observation.Status</td></tr> }
                @foreach (var alert in Model.Alerts) { <tr><td>@alert.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>Alert (@alert.Severity)</td><td>@alert.Message</td></tr> }
                @if (Model.FacilityVisits.Count + Model.WelfareChecks.Count + Model.WelfareObservations.Count + Model.Alerts.Count == 0) { <tr><td colspan="3" class="text-muted">No other captures in this period.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
