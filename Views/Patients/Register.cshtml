@model SmartElderlyCare.Models.PatientRegistrationInputModel
@{
    ViewData["Title"] = "Register Patient";
}

<div class="container py-4">
    <div class="mb-4">
        <span class="eyebrow">Patient registry</span>
        <h1 class="mt-3 mb-1">Register an elderly patient</h1>
        <p class="text-muted">Capture the patient’s bio-data and enrol them in a chronic care programme.</p>
    </div>

    <form asp-action="Register" method="post" class="card border-0 shadow-sm p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <h2 class="h5 mb-3">Bio-data</h2>
        <div class="row g-3">
            <div class="col-md-4"><label asp-for="PatientNumber" class="form-label"></label><input asp-for="PatientNumber" class="form-control" /><span asp-validation-for="PatientNumber" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" class="form-control" /><span asp-validation-for="DateOfBirth" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Sex" class="form-label"></label><select asp-for="Sex" class="form-select"><option value="">Select sex</option><option>Female</option><option>Male</option><option>Other</option></select><span asp-validation-for="Sex" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="NationalId" class="form-label"></label><input asp-for="NationalId" class="form-control" /><span asp-validation-for="NationalId" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger"></span></div>
        </div>

        <h2 class="h5 mt-4 mb-3">Chronic care programme</h2>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="MedicalCondition" class="form-label"></label><input asp-for="MedicalCondition" class="form-control" placeholder="e.g. hypertension, diabetes" /><span asp-validation-for="MedicalCondition" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="ChronicCareProgramme" class="form-label"></label><input asp-for="ChronicCareProgramme" class="form-control" placeholder="e.g. Hypertension follow-up" /><span asp-validation-for="ChronicCareProgramme" class="text-danger"></span></div>
        </div>

        <h2 class="h5 mt-4 mb-3">Emergency contact</h2>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="EmergencyContactName" class="form-label"></label><input asp-for="EmergencyContactName" class="form-control" /><span asp-validation-for="EmergencyContactName" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="EmergencyContactPhone" class="form-label"></label><input asp-for="EmergencyContactPhone" class="form-control" /><span asp-validation-for="EmergencyContactPhone" class="text-danger"></span></div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn primary-button px-4" type="submit">Register patient</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
