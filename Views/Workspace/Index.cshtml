@model SmartElderlyCare.Models.RoleWorkspaceViewModel
@{
    ViewData["Title"] = "My Workspace";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <a asp-controller="Home" asp-action="Dashboard" class="text-success">← Main dashboard</a>
            <span class="eyebrow d-block mt-3">Role workspace</span>
            <h1 class="mt-3 mb-1">Welcome, @Model.DisplayName</h1>
            <p class="text-muted mb-0">Your workspace is arranged for the <strong>@Model.RoleName</strong> role.</p>
        </div>
        <span class="badge rounded-pill text-bg-light border px-3 py-2">@Model.RoleName</span>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button class="btn btn-outline-secondary btn-sm" type="submit">Sign out</button>
        </form>
    </div>

    <div class="row g-4">
        @foreach (var item in Model.Actions)
        {
            <div class="col-md-6 col-xl-4">
                <article class="card border-0 shadow-sm h-100 p-4">
                    <span class="quick-action-icon quick-action-@item.Style mb-3">→</span>
                    <h2 class="h5">@item.Title</h2>
                    <p class="text-muted">@item.Description</p>
                    @if (!string.IsNullOrWhiteSpace(item.Page))
                    {
                        <a class="btn btn-outline-success mt-auto" asp-page="@item.Page" asp-area="@item.Area">Open</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-success mt-auto" asp-controller="@item.Controller" asp-action="@item.Action">Open</a>
                    }
                </article>
            </div>
        }
    </div>

    @if (Model.RoleName == SmartElderlyCare.Models.ApplicationRoles.Family)
    {
        <section class="mt-5">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                <div>
                    <span class="eyebrow">Permitted care history</span>
                    <h2 class="mt-2 mb-0">My linked relatives</h2>
                </div>
                <a class="btn btn-outline-success" asp-controller="Patients" asp-action="Index">Open patient registry</a>
            </div>

            @if (Model.LinkedPatients.Count == 0)
            {
                <div class="card border-0 shadow-sm p-4">
                    <p class="text-muted mb-0">
                        No relatives are linked to your account yet. Please contact the care facility so a nurse or administrator can grant you access.
                    </p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var relative in Model.LinkedPatients)
                    {
                        <div class="col-md-6 col-xl-4">
                            <article class="card border-0 shadow-sm h-100 p-4">
                                <h3 class="h6 mb-1">@relative.PatientName</h3>
                                <p class="text-muted mb-3">
                                    @relative.PatientNumber · @relative.MedicalCondition<br />
                                    <span class="small">@(relative.Relationship ?? "Family member") · @relative.AccessLevel access</span>
                                </p>
                                <a class="btn btn-outline-success mt-auto" asp-controller="Patients" asp-action="History" asp-route-id="@relative.PatientId">View care history</a>
                            </article>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>
