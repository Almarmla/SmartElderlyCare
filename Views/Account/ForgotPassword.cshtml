@{
    ViewData["Title"] = "Password Reset";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm p-4 p-md-5">
                <span class="eyebrow">Account recovery</span>
                <h1 class="mt-3 mb-3">Forgotten your password?</h1>

                <div class="alert alert-warning d-flex gap-3 align-items-start" role="alert">
                    <span class="fs-4 lh-1" aria-hidden="true">!</span>
                    <div>
                        <strong>Self-service password resets are disabled.</strong>
                        <p class="mb-0 mt-2">
                            For clinical security and patient data protection, self-service password resets are
                            disabled. Please request a password reset from your DHIO or HIU Administrator.
                        </p>
                    </div>
                </div>

                <p class="text-muted">
                    Password reset must be performed by a System Administrator. Please contact your facility HIU or
                    Super Administrator to reset your credentials.
                </p>

                <div class="card border-0 bg-light mt-4">
                    <div class="card-body">
                        <h2 class="h6 text-uppercase text-muted mb-3">Administrator support contacts</h2>
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Email</dt>
                            <dd class="col-sm-7">
                                <a href="mailto:almarmlambo@gmail.com">almarmlambo@gmail.com</a>
                            </dd>
                            <dt class="col-sm-5">Phone</dt>
                            <dd class="col-sm-7 mb-0">
                                <a href="tel:+263775725114">+263 775 725 114</a>
                                <span class="text-muted mx-1">/</span>
                                <a href="tel:+263717065055">+263 717 065 055</a>
                            </dd>
                        </dl>
                    </div>
                </div>

                <p class="text-muted small mt-4 mb-0">
                    Administrators can reset your password from the User Management page. Once reset, you will be able
                    to sign in and change it from your workspace.
                </p>

                <a class="btn primary-button w-100 mt-4" asp-action="Login">Return to Sign In</a>
            </div>
        </div>
    </div>
</div>
