@model SmartElderlyCare.Models.FacilityVisitInputModel
@{
    ViewData["Title"] = "Record Facility Visit";
}

<div class="container py-4">
    <div class="mb-4">
        <span class="eyebrow">Facility Nurse</span>
        <h1 class="mt-3">Record patient visit</h1>
        <p class="text-muted">Capture vital signs, diagnosis, and treatment provided during the facility visit.</p>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <form asp-action="RecordVisit" method="post" class="row g-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-12">
            <div class="card shadow-sm border-0 p-4">
                <h2 class="h5 mb-3">Visit details</h2>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="PatientId" class="form-label"></label>
                        <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-select">
                            <option value="">Choose a patient</option>
                        </select>
                        <span asp-validation-for="PatientId" class="text-danger"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="FacilityName" class="form-label"></label>
                        <input asp-for="FacilityName" class="form-control" />
                        <span asp-validation-for="FacilityName" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0 p-4">
                <h2 class="h5 mb-3">Vital signs</h2>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="SystolicBloodPressure" class="form-label"></label>
                        <input asp-for="SystolicBloodPressure" class="form-control" />
                        <span asp-validation-for="SystolicBloodPressure" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DiastolicBloodPressure" class="form-label"></label>
                        <input asp-for="DiastolicBloodPressure" class="form-control" />
                        <span asp-validation-for="DiastolicBloodPressure" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="PulseRate" class="form-label"></label>
                        <input asp-for="PulseRate" class="form-control" />
                        <span asp-validation-for="PulseRate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="TemperatureCelsius" class="form-label"></label>
                        <input asp-for="TemperatureCelsius" class="form-control" />
                        <span asp-validation-for="TemperatureCelsius" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="BloodGlucoseMgDl" class="form-label"></label>
                        <input asp-for="BloodGlucoseMgDl" class="form-control" />
                        <span asp-validation-for="BloodGlucoseMgDl" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="RespiratoryRate" class="form-label"></label>
                        <input asp-for="RespiratoryRate" class="form-control" />
                        <span asp-validation-for="RespiratoryRate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="OxygenSaturation" class="form-label"></label>
                        <input asp-for="OxygenSaturation" class="form-control" />
                        <span asp-validation-for="OxygenSaturation" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="WeightKilograms" class="form-label"></label>
                        <input asp-for="WeightKilograms" class="form-control" />
                        <span asp-validation-for="WeightKilograms" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card shadow-sm border-0 p-4">
                <h2 class="h5 mb-3">Clinical record</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Diagnosis" class="form-label"></label>
                        <textarea asp-for="Diagnosis" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Diagnosis" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Treatment" class="form-label"></label>
                        <textarea asp-for="Treatment" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Treatment" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="ClinicalNotes" class="form-label"></label>
                        <textarea asp-for="ClinicalNotes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="ClinicalNotes" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <button class="btn primary-button px-4" type="submit">Save facility visit</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
