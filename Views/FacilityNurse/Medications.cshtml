@model SmartElderlyCare.Models.MedicationInputModel
@using SmartElderlyCare.Models
@{
    ViewData["Title"] = "Log Patient Medication";
    var medications = ViewData["Medications"] as List<PatientMedication> ?? new List<PatientMedication>();
}

<div class="container py-4">
    <div class="mb-4">
        <span class="eyebrow">Facility Nurse</span>
        <h1 class="mt-3">Log patient medication</h1>
        <p class="text-muted">Record prescribed medications so nurses and VHWs can review adherence.</p>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <form asp-action="Medications" method="post" class="row g-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="col-12">
            <div class="card shadow-sm border-0 p-4">
                <h2 class="h5 mb-3">Medication details</h2>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="PatientId" class="form-label"></label>
                        <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-select">
                            <option value="">Choose a patient</option>
                        </select>
                        <span asp-validation-for="PatientId" class="text-danger"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="MedicationName" class="form-label"></label>
                        <input asp-for="MedicationName" class="form-control" placeholder="e.g. Amlodipine" />
                        <span asp-validation-for="MedicationName" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Dosage" class="form-label"></label>
                        <input asp-for="Dosage" class="form-control" placeholder="e.g. 10 mg" />
                        <span asp-validation-for="Dosage" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Frequency" class="form-label"></label>
                        <input asp-for="Frequency" class="form-control" placeholder="e.g. Twice daily" />
                        <span asp-validation-for="Frequency" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Route" class="form-label"></label>
                        <input asp-for="Route" class="form-control" placeholder="e.g. Oral" />
                        <span asp-validation-for="Route" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check form-switch mt-4 pt-2">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <button class="btn primary-button px-4" type="submit">Log medication</button>
        </div>
    </form>

    @if (medications.Count > 0)
    {
        <div class="col-12 mt-4">
            <div class="card shadow-sm border-0 p-4">
                <h2 class="h5 mb-3">Prescribed medications</h2>
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Dosage</th>
                                <th>Frequency</th>
                                <th>Route</th>
                                <th>Prescribed</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var medication in medications)
                            {
                                <tr>
                                    <td>@medication.MedicationName</td>
                                    <td>@(medication.Dosage ?? "—")</td>
                                    <td>@(medication.Frequency ?? "—")</td>
                                    <td>@(medication.Route ?? "—")</td>
                                    <td>@medication.PrescribedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (medication.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Discontinued</span>
                                        }
                                    </td>
                                    <td>
                                        @if (medication.IsActive)
                                        {
                                            <form asp-action="DiscontinueMedication" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="medicationId" value="@medication.Id" />
                                                <input type="hidden" name="patientId" value="@medication.PatientId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Discontinue</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}