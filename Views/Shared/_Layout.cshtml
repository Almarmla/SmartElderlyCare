<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartElderlyCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartElderlyCare.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark app-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="app-brand-mark">S</span>
                    <span>SmartElderlyCare</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Workspace" asp-action="Index">My Workspace</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Patients" asp-action="Index">Patients</a>
                            </li>

                            @if (User.IsInRole(ApplicationRoles.Nurse) || User.IsInRole(ApplicationRoles.FacilityNurse))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="facilityDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Facility</a>
                                    <div class="dropdown-menu" aria-labelledby="facilityDropdown">
                                        <a class="dropdown-item" asp-area="" asp-controller="FacilityNurse" asp-action="RecordVisit">Record Visit</a>
                                        <a class="dropdown-item" asp-area="" asp-controller="FacilityNurse" asp-action="Medications">Medications</a>
                                        <a class="dropdown-item" asp-area="" asp-page="/Returns/MonthlySummary">Monthly Returns</a>
                                    </div>
                                </li>
                            }

                            @if (User.IsInRole(ApplicationRoles.VHW))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Vhw/WelfareCheck">Welfare Check</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Vhw/Register">VHW Register</a>
                                </li>
                            }

                            @if (User.IsInRole(ApplicationRoles.HiuClerk) || User.IsInRole(ApplicationRoles.RecordsStaff))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="hiuDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">HIU</a>
                                    <div class="dropdown-menu" aria-labelledby="hiuDropdown">
                                        <a class="dropdown-item" asp-area="" asp-page="/Hiu/Dashboard">HIU Dashboard</a>
                                        <a class="dropdown-item" asp-area="" asp-page="/Hiu/MonthlyReport">Monthly Reports</a>
                                    </div>
                                </li>
                            }

                            @if (User.IsInRole(ApplicationRoles.Dmo))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-area="" asp-page="/Reports/DistrictSummary">District Reports</a>
                                </li>
                            }

                            @if (User.IsInRole(ApplicationRoles.DhioAdmin) || User.IsInRole(ApplicationRoles.Administrator))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Administration</a>
                                    <div class="dropdown-menu" aria-labelledby="adminDropdown">
                                        <a class="dropdown-item" asp-area="Admin" asp-page="/Users/Index">Users</a>
                                        <a class="dropdown-item" asp-area="Admin" asp-page="/Thresholds/Edit">Thresholds</a>
                                        <a class="dropdown-item" asp-area="Admin" asp-page="/Roles/Index">Roles</a>
                                    </div>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "Account";
                            var roles = User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(claim => claim.Value).ToList();
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    @displayName
                                    @if (roles.Count > 0)
                                    {
                                        <span class="badge rounded-pill text-bg-light ms-1">@string.Join(", ", roles)</span>
                                    }
                                </a>
                                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
                                    @if (roles.Count > 0)
                                    {
                                        <h6 class="dropdown-header">@string.Join(", ", roles)</h6>
                                    }
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword">Change Password</a>
                                    <div class="dropdown-divider"></div>
                                    <form method="post" asp-area="" asp-controller="Account" asp-action="Logout">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item">Sign out</button>
                                    </form>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Sign in</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer border-top text-muted">
        <div class="container">
            &copy; 2026 - SmartElderlyCare - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
