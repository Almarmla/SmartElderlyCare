@page
@model SmartElderlyCare.Pages.Vhw.RegisterModel
@{
    ViewData["Title"] = "VHW Register";
    var currentTime = DateTimeOffset.UtcNow;
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <span class="eyebrow">Village Health Worker</span>
            <h1 class="mt-3 mb-2">Community register</h1>
            <p class="text-muted mb-0">Review active elderly patients and record their latest welfare check.</p>
        </div>
        <span class="badge text-bg-light border fs-6">@Model.Patients.Count active patients</span>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Patient</th>
                        <th scope="col">Chronic medical condition</th>
                        <th scope="col">Last visit</th>
                        <th scope="col">Welfare status</th>
                        <th scope="col">Medication adherence</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Patients.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No active elderly patients found.</td>
                    </tr>
                }
                @foreach (var patient in Model.Patients)
                {
                    <tr>
                        <td>
                            <strong>@patient.PatientNumber</strong>
                            <div>@patient.FullName</div>
                        </td>
                        <td>@(patient.MedicalCondition ?? "Not recorded")</td>
                        <td>
                        @if (patient.MostRecentCheck is null)
                        {
                            <span class="text-muted">No visit recorded</span>
                        }
                        else
                        {
                            @patient.MostRecentCheck.ObservedAt.ToLocalTime().ToString("dd MMM yyyy")
                        }
                        </td>
                        <td>
                        @if (patient.MostRecentCheck is null)
                        {
                            <span class="badge text-bg-secondary">No visit</span>
                        }
                        else
                        {
                            <span class="badge @SmartElderlyCare.Pages.Vhw.RegisterModel.StatusBadgeClass(patient.MostRecentCheck.Status)">
                                @SmartElderlyCare.Pages.Vhw.RegisterModel.StatusLabel(patient.MostRecentCheck.Status)
                            </span>
                        }
                        @if (patient.IsOverdue(currentTime))
                        {
                            <span class="badge text-bg-warning ms-1">Overdue</span>
                        }
                        </td>
                        <td>
                        @if (patient.MostRecentCheck is null)
                        {
                            <span class="text-muted">No visit recorded</span>
                        }
                        else if (patient.MostRecentCheck.MedicationTaken)
                        {
                            <span class="text-success">Yes</span>
                        }
                        else
                        {
                            <span class="text-danger">No</span>
                        }
                        </td>
                        <td>
                            <a asp-page="/Vhw/WelfareCheck"
                               asp-route-PatientId="@patient.PatientId"
                               class="btn btn-sm btn-outline-success">Record Visit</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
