@page
@model SmartElderlyCare.Pages.Vhw.WelfareCheckModel
@{
    ViewData["Title"] = "VHW Welfare Check";
}

<div class="container py-4 vhw-form-page">
    <div class="text-center mb-4">
        <span class="eyebrow">Village Health Worker</span>
        <h1 class="mt-3">Welfare check</h1>
        <p class="text-muted fs-5">Choose the answers that best describe the patient today.</p>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success text-center fs-5" role="alert">@successMessage</div>
    }

    <form method="post" class="vhw-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="vhw-field">
            <label asp-for="Input.PatientId"></label>
            <select asp-for="Input.PatientId" asp-items="Model.Patients" class="form-select form-select-lg">
                <option value="">Choose a patient</option>
            </select>
            <span asp-validation-for="Input.PatientId" class="text-danger"></span>
        </div>

        <div class="vhw-field">
            <label asp-for="Input.Mobility"></label>
            <select asp-for="Input.Mobility" class="form-select form-select-lg">
                <option value="">Choose mobility</option>
                <option value="Independent">Walks independently</option>
                <option value="NeedsSupport">Needs some support</option>
                <option value="Unable">Unable to walk</option>
            </select>
            <span asp-validation-for="Input.Mobility" class="text-danger"></span>
        </div>

        <div class="vhw-check-row">
            <input asp-for="Input.MedicationTaken" class="form-check-input" />
            <label asp-for="Input.MedicationTaken" class="form-check-label">Medication was taken today</label>
        </div>

        <div class="vhw-field">
            <label asp-for="Input.GeneralCondition"></label>
            <select asp-for="Input.GeneralCondition" asp-items="Html.GetEnumSelectList<VhwWelfareStatus>()" class="form-select form-select-lg"></select>
            <span asp-validation-for="Input.GeneralCondition" class="text-danger"></span>
        </div>

        <div class="vhw-field">
            <label asp-for="Input.Mood"></label>
            <select asp-for="Input.Mood" class="form-select form-select-lg">
                <option value="">Choose mood</option>
                <option value="Good / Cheerful">Good / Cheerful</option>
                <option value="Calm / Neutral">Calm / Neutral</option>
                <option value="Withdrawn / Depressed">Withdrawn / Depressed</option>
                <option value="Agitated / Distressed">Agitated / Distressed</option>
            </select>
            <span asp-validation-for="Input.Mood" class="text-danger"></span>
        </div>

        <div class="vhw-field">
            <label asp-for="Input.Nutrition"></label>
            <select asp-for="Input.Nutrition" class="form-select form-select-lg">
                <option value="">Choose nutrition status</option>
                <option value="Eating well">Eating well</option>
                <option value="Reduced appetite">Reduced appetite</option>
                <option value="Poor intake / Dehydrated">Poor intake / Dehydrated</option>
            </select>
            <span asp-validation-for="Input.Nutrition" class="text-danger"></span>
        </div>

        <div class="vhw-field">
            <label asp-for="Input.SafetyConcern"></label>
            <select asp-for="Input.SafetyConcern" class="form-select form-select-lg">
                <option value="">No safety concern selected</option>
                <option value="Fall risk">Fall risk</option>
                <option value="Living alone issues">Living alone issues</option>
                <option value="None">None</option>
            </select>
            <span asp-validation-for="Input.SafetyConcern" class="text-danger"></span>
        </div>

        <div class="vhw-check-row">
            <input asp-for="Input.FollowUpRequired" class="form-check-input" />
            <label asp-for="Input.FollowUpRequired" class="form-check-label">Follow-up is required</label>
        </div>

        <div class="vhw-field">
            <label asp-for="Input.FollowUpAt"></label>
            <input asp-for="Input.FollowUpAt" type="datetime-local" class="form-control form-control-lg" />
            <span asp-validation-for="Input.FollowUpAt" class="text-danger"></span>
        </div>

        <div class="vhw-field">
            <label asp-for="Input.Notes"></label>
            <textarea asp-for="Input.Notes" class="form-control form-control-lg" rows="4" placeholder="Write anything important..."></textarea>
            <span asp-validation-for="Input.Notes" class="text-danger"></span>
        </div>

        <button type="submit" class="btn primary-button btn-lg w-100 vhw-save-button">Save welfare check</button>
    </form>

    @if (Model.Medications.Count > 0)
    {
        <div class="vhw-medications mt-4">
            <h2 class="h5 mb-3">Prescribed medications</h2>
            <ul class="list-group">
                @foreach (var medication in Model.Medications)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@medication.MedicationName</strong>
                            @if (!string.IsNullOrWhiteSpace(medication.Dosage) || !string.IsNullOrWhiteSpace(medication.Route) || !string.IsNullOrWhiteSpace(medication.Frequency))
                            {
                                <div class="text-muted">@medication.Dosage @medication.Route @medication.Frequency</div>
                            }
                        </div>
                        @if (medication.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Discontinued</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
