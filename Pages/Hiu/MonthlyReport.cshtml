@page
@model SmartElderlyCare.Pages.Hiu.MonthlyReportModel
@{
    ViewData["Title"] = "Monthly DHIS2 Report";
}

@functions {
    static string SubmissionLabel(SmartElderlyCare.Models.Dhis2SubmissionStatus status) => status switch
    {
        SmartElderlyCare.Models.Dhis2SubmissionStatus.Submitted => "Submitted",
        SmartElderlyCare.Models.Dhis2SubmissionStatus.Pending => "Pending",
        SmartElderlyCare.Models.Dhis2SubmissionStatus.Failed => "Failed",
        _ => status.ToString()
    };

    static string SubmissionBadge(SmartElderlyCare.Models.Dhis2SubmissionStatus status) => status switch
    {
        SmartElderlyCare.Models.Dhis2SubmissionStatus.Submitted => "text-bg-success",
        SmartElderlyCare.Models.Dhis2SubmissionStatus.Pending => "text-bg-warning",
        SmartElderlyCare.Models.Dhis2SubmissionStatus.Failed => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}

<div class="container py-4">
    <a asp-page="/Dashboard" class="text-success">← HIU dashboard</a>
    <div class="mb-4 mt-3">
        <span class="eyebrow">DHIS2 reporting</span>
        <h1 class="mt-3 mb-1">Monthly summary report</h1>
        <p class="text-muted">Export captured indicators in DHIS2 data-value format for upload or capture.</p>
    </div>

    @if (TempData["SubmissionSuccess"] is string submissionSuccess)
    {
        <div class="alert alert-success">@submissionSuccess</div>
    }
    @if (TempData["SubmissionWarning"] is string submissionWarning)
    {
        <div class="alert alert-warning">@submissionWarning</div>
    }

    <form method="post" asp-page-handler="Download" class="card border-0 shadow-sm p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3 align-items-end">
            <div class="col-md-3"><label asp-for="Year" class="form-label"></label><input asp-for="Year" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Month" class="form-label"></label><select asp-for="Month" class="form-select">@for (var month = 1; month <= 12; month++) { <option value="@month">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(month)</option> }</select></div>
            <div class="col-md-4"><label asp-for="OrganisationUnit" class="form-label"></label><input asp-for="OrganisationUnit" class="form-control" /></div>
            <div class="col-md-2"><button class="btn primary-button w-100" type="submit">Download CSV</button></div>
        </div>
    </form>

    <div class="card border-0 shadow-sm p-4 mt-4">
        <h2 class="h5">Included indicators</h2>
        <ul class="mb-0">
            <li>Total vital-sign readings</li>
            <li>Elevated blood-pressure readings</li>
            <li>Total welfare observations</li>
            <li>Urgent welfare observations</li>
            <li>Welfare observations needing attention</li>
        </ul>
    </div>

    <div class="card border-0 shadow-sm p-4 mt-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-3">
            <h2 class="h5 mb-0">Recent submission history</h2>
            <span class="small text-muted">Recorded each time a DHIS2 report was generated</span>
        </div>
        @if (Model.Submissions.Count == 0)
        {
            <p class="text-muted mb-0">No DHIS2 indicator submissions have been recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                    <tr><th>Submitted</th><th>Period</th><th>Organisation unit</th><th>Indicators</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var submission in Model.Submissions)
                    {
                        <tr>
                            <td class="text-nowrap">@submission.At.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td class="text-nowrap">@submission.MonthName @submission.Year</td>
                            <td>@submission.OrganisationUnit</td>
                            <td>@submission.IndicatorCount</td>
                            <td><span class="badge @SubmissionBadge(submission.Status)">@SubmissionLabel(submission.Status)</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
