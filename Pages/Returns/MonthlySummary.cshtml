@page
@model SmartElderlyCare.Pages.Returns.MonthlySummaryModel
@using SmartElderlyCare.Models
@{
    ViewData["Title"] = "Monthly Facility Returns";
}

<div class="container py-4">
    <div class="mb-4">
        <span class="eyebrow">Facility reporting</span>
        <h1 class="mt-3 mb-2">Monthly Facility Returns</h1>
        <p class="text-muted mb-0">Compile and submit facility visit information for the selected reporting month.</p>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form method="get" class="card border-0 shadow-sm p-3 mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label asp-for="Year" class="form-label">Year</label>
                <input asp-for="Year" class="form-control" min="2000" max="2100" />
            </div>
            <div class="col-sm-4 col-md-3">
                <label asp-for="Month" class="form-label">Month</label>
                <select asp-for="Month" class="form-select">
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)</option>
                }
                </select>
            </div>
            <div class="col-sm-4 col-md-3">
                <button type="submit" class="btn btn-outline-success w-100">View month</button>
            </div>
        </div>
    </form>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
        <h2 class="h4 mb-0">@Model.SelectedMonthName @Model.Year return</h2>
        <div>
        @if (Model.CurrentStatus is MonthlyReturnStatus status)
        {
            <span class="badge fs-6 @(status switch
                {
                    MonthlyReturnStatus.Approved => "text-bg-success",
                    MonthlyReturnStatus.Submitted => "text-bg-primary",
                    _ => "text-bg-secondary"
                })">@status</span>
        }
        else
        {
            <span class="badge text-bg-light border fs-6">Not compiled</span>
        }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted">Total visits completed</small>
                <strong class="display-6">@Model.TotalVisitsCompleted</strong>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted">Completeness score</small>
                <strong class="display-6">@Model.CompletenessScore.ToString("0.0")%</strong>
                <small class="text-muted">BP, pulse, temperature, and diagnosis</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted">Alerts raised</small>
                <strong class="display-6">@Model.AlertsRaised</strong>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 h-100">
                <small class="text-muted">Reporting month</small>
                <strong class="h3">@Model.Month.ToString("00")/@Model.Year</strong>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Diagnoses summary</h2>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Diagnosis</th><th class="text-end">Visit count</th></tr>
                    </thead>
                    <tbody>
                    @if (Model.Diagnoses.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted">No completed visits recorded for this month.</td></tr>
                    }
                    @foreach (var diagnosis in Model.Diagnoses)
                    {
                        <tr><td>@diagnosis.Name</td><td class="text-end">@diagnosis.VisitCount</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <h2 class="h5">Validation history</h2>
            @if (Model.ValidationHistory.Count == 0)
            {
                <p class="text-muted mb-0">No validation decisions have been recorded for this return.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Decision</th>
                                <th>Validated by</th>
                                <th>Date</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var validation in Model.ValidationHistory)
                        {
                            <tr>
                                <td>
                                    <span class="badge @(validation.Status switch
                                        {
                                            MonthlyReturnValidationStatus.Approved => "text-bg-success",
                                            MonthlyReturnValidationStatus.Rejected => "text-bg-danger",
                                            _ => "text-bg-secondary"
                                        })">@validation.Status</span>
                                </td>
                                <td>@validation.ValidatorName</td>
                                <td>@validation.ValidatedAt.ToString("g")</td>
                                <td>@validation.Notes</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (User.IsInRole("HiuClerk") && Model.CurrentStatus == MonthlyReturnStatus.Submitted)
    {
        <div class="card border-0 shadow-sm p-3 mb-4">
            <h2 class="h5">Validate return</h2>
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Year" />
                <input type="hidden" asp-for="Month" />
                <label for="ValidationNotes" class="form-label">Validation notes (required)</label>
                <textarea id="ValidationNotes" name="notes" class="form-control mb-3" rows="3" required></textarea>
                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" asp-page-handler="Approve" class="btn btn-success">Approve Return</button>
                    <button type="submit" asp-page-handler="Reject" class="btn btn-danger">Reject Return</button>
                </div>
            </form>
        </div>
    }

    <div class="d-flex flex-column flex-sm-row gap-2">
        <form method="post" asp-page-handler="Compile">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Year" />
            <input type="hidden" asp-for="Month" />
            <button type="submit" class="btn btn-outline-success">Compile &amp; Save Draft</button>
        </form>
        <form method="post" asp-page-handler="Submit">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Year" />
            <input type="hidden" asp-for="Month" />
            <button type="submit" class="btn btn-success">Submit to HIU</button>
        </form>
    </div>
</div>
