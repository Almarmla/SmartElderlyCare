@page
@model SmartElderlyCare.Areas.Admin.Pages.AuditLogs.IndexModel
@{
    ViewData["Title"] = "Audit Log";
}

@functions {
    static string ActionLabel(AdministrationAction action) => action switch
    {
        AdministrationAction.UserCreated => "User created",
        AdministrationAction.UserDisabled => "User disabled",
        AdministrationAction.UserUnlocked => "User unlocked",
        AdministrationAction.PasswordReset => "Password reset",
        AdministrationAction.UserUpdated => "User updated",
        AdministrationAction.RoleChanged => "Role changed",
        AdministrationAction.ThresholdCreated => "Threshold created",
        AdministrationAction.ThresholdUpdated => "Threshold updated",
        AdministrationAction.ThresholdDisabled => "Threshold disabled",
        _ => action.ToString()
    };

    static string BadgeClass(AdministrationAction action) => action switch
    {
        AdministrationAction.UserCreated => "text-bg-success",
        AdministrationAction.UserDisabled => "text-bg-danger",
        AdministrationAction.UserUnlocked => "text-bg-warning",
        AdministrationAction.PasswordReset => "text-bg-warning",
        AdministrationAction.UserUpdated => "text-bg-info",
        AdministrationAction.RoleChanged => "text-bg-info",
        AdministrationAction.ThresholdCreated => "text-bg-primary",
        AdministrationAction.ThresholdUpdated => "text-bg-primary",
        AdministrationAction.ThresholdDisabled => "text-bg-secondary",
        _ => "text-bg-secondary"
    };
}

<div class="container py-4">
    <a asp-page="/Index" asp-area="Admin" class="text-success">← Administration</a>
    <h1 class="mt-3">Audit log</h1>
    <p class="text-muted">Review the trail of administrative actions, including account management and threshold changes.</p>

    <div class="card border-0 shadow-sm p-4 mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label" for="action">Action</label>
                <select asp-for="Action" id="action" class="form-select">
                    <option value="">All actions</option>
                    @foreach (var action in Model.Actions)
                    {
                        <option value="@action">@action</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="from">From</label>
                <input asp-for="From" id="from" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="to">To</label>
                <input asp-for="To" id="to" type="date" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="search">Performed by</label>
                <input asp-for="Search" id="search" class="form-control" placeholder="Name or email" />
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn primary-button px-4" type="submit">Filter</button>
                <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
                <span class="ms-auto align-self-center small text-muted">@Model.TotalCount record(s)</span>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                <tr>
                    <th>When</th>
                    <th>Action</th>
                    <th>Performed By</th>
                    <th>Entity</th>
                    <th>Details</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Logs.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No audit records match your criteria.</td>
                    </tr>
                }
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td class="text-nowrap">@log.PerformedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="badge @BadgeClass(log.Action)">@ActionLabel(log.Action)</span></td>
                        <td>
                            @(string.IsNullOrWhiteSpace(log.PerformedByUser.DisplayName)
                                ? log.PerformedByUser.Email
                                : log.PerformedByUser.DisplayName)
                        </td>
                        <td class="text-nowrap">
                            @log.EntityName
                            <span class="text-muted small">· @log.EntityId</span>
                        </td>
                        <td>@(log.Details ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.PageCount > 1)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3">
                <span class="small text-muted">Page @Model.PageNumber of @Model.PageCount</span>
                <nav aria-label="Audit log pages">
                    <ul class="pagination pagination-sm mb-0">
                        @if (Model.PageNumber > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index" asp-all-route-data="@(Model.PageRoute(Model.PageNumber - 1))">Previous</a>
                            </li>
                        }
                        @for (var pageIndex = 1; pageIndex <= Model.PageCount; pageIndex++)
                        {
                            <li class="page-item @(pageIndex == Model.PageNumber ? "active" : null)">
                                <a class="page-link" asp-page="./Index" asp-all-route-data="@Model.PageRoute(pageIndex)">@pageIndex</a>
                            </li>
                        }
                        @if (Model.PageNumber < Model.PageCount)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-page="./Index" asp-all-route-data="@(Model.PageRoute(Model.PageNumber + 1))">Next</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>