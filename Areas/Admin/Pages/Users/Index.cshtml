@page
@model SmartElderlyCare.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Manage Users";
}

<div class="container py-4">
    <a asp-page="/Index" asp-area="Admin" class="text-success">← Administration</a>
    <h1 class="mt-3">Manage users</h1>
    <p class="text-muted">Create accounts, assign a role, and manage access when a user joins or leaves the service.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    @if (TempData["UserError"] is string userError)
    {
        <div class="alert alert-danger">@userError</div>
    }
    <div class="card border-0 shadow-sm p-4 mb-4">
        <h2 class="h5">Create user account</h2>
        <form method="post" asp-page-handler="Create" class="row g-3">
            <div class="col-md-6"><label asp-for="Input.DisplayName" class="form-label"></label><input asp-for="Input.DisplayName" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Input.Password" class="form-label"></label><input asp-for="Input.Password" class="form-control" /></div>
            <div class="col-md-6">
                <label asp-for="Input.Role" class="form-label"></label>
                <select asp-for="Input.Role" class="form-select">
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <div class="form-text">The selected role determines which workspace and pages the user can open after signing in.</div>
            </div>
            <div class="col-12"><button class="btn primary-button px-4" type="submit">Create account</button></div>
        </form>
    </div>

    <div class="card border-0 shadow-sm p-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-3">
            <h2 class="h5 mb-0">User accounts</h2>
            <form method="get" class="d-flex gap-2" role="search">
                <label asp-for="SearchTerm" class="visually-hidden">Search users</label>
                <input asp-for="SearchTerm" class="form-control" placeholder="Search name or email" />
                <button class="btn btn-outline-success" type="submit">Search</button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
                }
            </form>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>                <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            @(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "No user accounts found." : "No users match your search.")
                        </td>
                    </tr>
                }
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td colspan="5">
                            <form method="post" asp-page-handler="Update" class="row g-2 align-items-end">
                                <input type="hidden" name="id" value="@user.Id" />
                                <div class="col-lg-3"><label class="form-label small">Name</label><input name="displayName" value="@user.DisplayName" class="form-control form-control-sm" /></div>
                                <div class="col-lg-3"><label class="form-label small">Email</label><input name="email" value="@user.Email" class="form-control form-control-sm" /></div>
                                <div class="col-lg-2"><label class="form-label small">Role</label><select name="role" class="form-select form-select-sm">@foreach (var role in Model.Roles) { <option value="@role" selected="@(Model.UserRoles[user.Id] == role)">@role</option> }</select></div>
                                <div class="col-lg-2"><span class="small text-muted d-block">Status</span><span>@(user.IsActive ? "Active" : "Inactive")</span></div>
                                <div class="col-lg-2 d-flex gap-1"><button class="btn btn-sm btn-outline-success" type="submit">Save</button></div>
                            </form>
                            @if (user.IsActive)
                            {
                                <form method="post" asp-page-handler="Deactivate" class="d-inline mt-2">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Deactivate</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Reactivate" class="d-inline mt-2">
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button class="btn btn-sm btn-outline-success" type="submit">Reactivate</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
