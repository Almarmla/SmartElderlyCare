@page
@model SmartElderlyCare.Areas.Admin.Pages.Roles.IndexModel
@{
    ViewData["Title"] = "Roles";
}

<div class="container py-4">
    <a asp-page="/Index" asp-area="Admin" class="text-success">← Administration</a>
    <h1 class="mt-3">Roles</h1>
    <p class="text-muted">Review the roles available for user accounts.</p>

    <div class="card border-0 shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Available roles</h2>
            <a class="btn btn-outline-success btn-sm" asp-page="/Users/Index" asp-area="Admin">Manage users</a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Identity ID</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var role in Model.Roles)
                {
                    <tr>
                        <td>@role.Name</td>
                        <td><code>@role.Id</code></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
