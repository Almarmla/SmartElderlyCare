@page "{id:int?}"
@model SmartElderlyCare.Areas.Admin.Pages.Thresholds.EditModel
@{
    ViewData["Title"] = "Edit Threshold";
}

<div class="container py-4">
    <a asp-page="/Index" asp-area="Admin" class="text-success">← Administration</a>
    <h1 class="mt-3">@(Model.Input.Id.HasValue ? "Edit" : "Add") threshold</h1>
    <p class="text-muted">Set safe value ranges for a clinical condition and metric.</p>

    <form method="post" class="card border-0 shadow-sm p-4">
        <input asp-for="Input.Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /></div>
            <div class="col-md-6"><label asp-for="Input.MedicalCondition" class="form-label"></label><input asp-for="Input.MedicalCondition" class="form-control" placeholder="e.g. hypertension" /></div>
            <div class="col-md-6"><label asp-for="Input.Metric" class="form-label"></label><select asp-for="Input.Metric" asp-items="Html.GetEnumSelectList<ThresholdMetric>()" class="form-select"></select></div>
            <div class="col-md-3"><label asp-for="Input.MinimumValue" class="form-label"></label><input asp-for="Input.MinimumValue" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Input.MaximumValue" class="form-label"></label><input asp-for="Input.MaximumValue" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Input.CriticalLow" class="form-label"></label><input asp-for="Input.CriticalLow" class="form-control" /></div>
            <div class="col-md-3"><label asp-for="Input.CriticalHigh" class="form-label"></label><input asp-for="Input.CriticalHigh" class="form-control" /></div>
            <div class="col-md-4"><label asp-for="Input.Unit" class="form-label"></label><input asp-for="Input.Unit" class="form-control" placeholder="e.g. mmHg" /></div>
            <div class="col-md-4"><label asp-for="Input.Severity" class="form-label"></label><select asp-for="Input.Severity" asp-items="Html.GetEnumSelectList<AlertSeverity>()" class="form-select"></select></div>
            <div class="col-md-4 d-flex align-items-end"><div class="form-check mb-2"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label"></label></div></div>
        </div>
        <div class="mt-4"><button class="btn primary-button px-4" type="submit">Save threshold</button></div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
